{
    "components": {
        "schemas": {
            "auth.ErrorResponse": {
                "properties": {
                    "code": {
                        "example": "unauthorized",
                        "type": "string"
                    },
                    "message": {
                        "example": "Authentication is required",
                        "type": "string"
                    },
                    "requestId": {
                        "example": "0e85b5d4-fdda-48fd-a026-45128b73afc3",
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "message",
                    "requestId"
                ],
                "type": "object"
            },
            "auth.Identity": {
                "properties": {
                    "displayName": {
                        "example": "Demo Customer",
                        "type": "string"
                    },
                    "id": {
                        "example": "6f8dc23d-01dd-41bc-8a5c-991a77f1c003",
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/auth.Role",
                        "example": "CUSTOMER"
                    }
                },
                "required": [
                    "displayName",
                    "id",
                    "role"
                ],
                "type": "object"
            },
            "auth.LoginRequest": {
                "properties": {
                    "email": {
                        "example": "customer@example.test",
                        "type": "string"
                    },
                    "password": {
                        "example": "local-demo-password",
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "type": "object"
            },
            "auth.LoginResponse": {
                "properties": {
                    "expiresAt": {
                        "example": "2026-11-07T12:00:00Z",
                        "type": "string"
                    },
                    "sessionToken": {
                        "example": "opaque-session-token",
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/auth.Identity"
                    }
                },
                "required": [
                    "expiresAt",
                    "sessionToken",
                    "user"
                ],
                "type": "object"
            },
            "auth.MeResponse": {
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/auth.Identity"
                    }
                },
                "required": [
                    "user"
                ],
                "type": "object"
            },
            "auth.Role": {
                "enum": [
                    "CUSTOMER",
                    "OPERATOR"
                ],
                "type": "string",
                "x-enum-varnames": [
                    "RoleCustomer",
                    "RoleOperator"
                ]
            },
            "health.Response": {
                "properties": {
                    "status": {
                        "example": "healthy",
                        "type": "string"
                    }
                },
                "required": [
                    "status"
                ],
                "type": "object"
            },
            "queue.CustomerTicketsResponse": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/queue.TicketResponse"
                        },
                        "type": "array",
                        "uniqueItems": false
                    }
                },
                "required": [
                    "items"
                ],
                "type": "object"
            },
            "queue.QueueErrorResponse": {
                "properties": {
                    "code": {
                        "example": "active_ticket_exists",
                        "type": "string"
                    },
                    "message": {
                        "example": "You already have an active ticket for this service today",
                        "type": "string"
                    },
                    "requestId": {
                        "example": "0e85b5d4-fdda-48fd-a026-45128b73afc3",
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "message",
                    "requestId"
                ],
                "type": "object"
            },
            "queue.ServiceResponse": {
                "properties": {
                    "branchId": {
                        "example": "10000000-0000-4000-8000-000000000001",
                        "type": "string"
                    },
                    "branchName": {
                        "example": "Quevo Demo Branch",
                        "type": "string"
                    },
                    "id": {
                        "example": "10000000-0000-4000-8000-000000000002",
                        "type": "string"
                    },
                    "name": {
                        "example": "General Service",
                        "type": "string"
                    }
                },
                "required": [
                    "branchId",
                    "branchName",
                    "id",
                    "name"
                ],
                "type": "object"
            },
            "queue.ServicesResponse": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/queue.ServiceResponse"
                        },
                        "type": "array",
                        "uniqueItems": false
                    }
                },
                "required": [
                    "items"
                ],
                "type": "object"
            },
            "queue.TicketResponse": {
                "properties": {
                    "branchId": {
                        "example": "10000000-0000-4000-8000-000000000001",
                        "type": "string"
                    },
                    "branchName": {
                        "example": "Quevo Demo Branch",
                        "type": "string"
                    },
                    "businessDate": {
                        "example": "2026-11-07",
                        "type": "string"
                    },
                    "id": {
                        "example": "d6d26a41-5c50-4ca9-b4f7-e82d7558da79",
                        "type": "string"
                    },
                    "joinedAt": {
                        "example": "2026-11-07T12:00:00Z",
                        "type": "string"
                    },
                    "serviceId": {
                        "example": "10000000-0000-4000-8000-000000000002",
                        "type": "string"
                    },
                    "serviceName": {
                        "example": "General Service",
                        "type": "string"
                    },
                    "status": {
                        "example": "WAITING",
                        "type": "string"
                    },
                    "ticketNumber": {
                        "example": "1",
                        "type": "string"
                    }
                },
                "required": [
                    "branchId",
                    "branchName",
                    "businessDate",
                    "id",
                    "joinedAt",
                    "serviceId",
                    "serviceName",
                    "status",
                    "ticketNumber"
                ],
                "type": "object"
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "in": "header",
                "name": "Authorization",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "description": "HTTP API for the Quevo application.",
        "title": "Quevo API",
        "version": "1.0.0"
    },
    "externalDocs": {
        "description": "API documentation in Swagger UI.",
        "url": "/swagger/"
    },
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Creates an opaque session for a seeded customer or operator. The token is returned to the web server only and must never be exposed to browser JavaScript.",
                "operationId": "postAuthLogin",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/auth.LoginRequest",
                                "summary": "request",
                                "description": "Login credentials"
                            }
                        }
                    },
                    "description": "Login credentials",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.LoginResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Service Unavailable"
                    }
                },
                "summary": "Sign in",
                "tags": [
                    "auth"
                ]
            }
        },
        "/auth/logout": {
            "post": {
                "description": "Revokes the current API session.",
                "operationId": "postAuthLogout",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Service Unavailable"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "Sign out",
                "tags": [
                    "auth"
                ]
            }
        },
        "/auth/me": {
            "get": {
                "description": "Returns the identity and role derived from the active session.",
                "operationId": "getAuthMe",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.MeResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Service Unavailable"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "Get current user",
                "tags": [
                    "auth"
                ]
            }
        },
        "/branches/{branchId}/services/{serviceId}/tickets": {
            "post": {
                "description": "Creates a WAITING ticket and allocates its number using the branch-local business date.",
                "operationId": "postCustomerTicket",
                "parameters": [
                    {
                        "description": "Branch ID",
                        "in": "path",
                        "name": "branchId",
                        "required": true,
                        "schema": {
                            "format": "uuid",
                            "type": "string"
                        }
                    },
                    {
                        "description": "Service ID",
                        "in": "path",
                        "name": "serviceId",
                        "required": true,
                        "schema": {
                            "format": "uuid",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/queue.TicketResponse"
                                }
                            }
                        },
                        "description": "Created"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/queue.QueueErrorResponse"
                                }
                            }
                        },
                        "description": "Bad Request"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/queue.QueueErrorResponse"
                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/queue.QueueErrorResponse"
                                }
                            }
                        },
                        "description": "Conflict"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/queue.QueueErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/auth.ErrorResponse"
                                }
                            }
                        },
                        "description": "Service Unavailable"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "Join a service queue",
                "tags": [
                    "tickets"
                ]
            }
        },
