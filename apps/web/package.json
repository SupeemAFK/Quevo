{
  "name": "quevo-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "generate:api": "bun --bun x openapi-typescript ../api/internal/apidocs/swagger.json -o src/client/api/schema.d.ts",
    "check:api": "bun --bun x openapi-typescript ../api/internal/apidocs/swagger.json -o src/client/api/schema.d.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun --bun x tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^31.0.0",
    "msw": "^3.0.3",
    "nitro": "^3.0.261103-rc",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
